import tkinter as tk
from tkinter import messagebox
from tkinter import ttk

class Turno:
    """Clase que actúa como estructura/registro para almacenar los datos de un turno."""
    def __init__(self, cedula, paciente, especialidad, fecha, hora):
        self.cedula = cedula
        self.paciente = paciente
        self.especialidad = especialidad
        self.fecha = fecha
        self.hora = hora

class AgendaTurnosApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Sistema de Gestion de Turnos Medicos - UEA")
        self.root.geometry("750x500")
        
        # Vector / Lista para almacenar las estructuras de tipo Turno
        self.lista_turnos = []
        
        self.crear_interfaz()

    def crear_interfaz(self):
        # Contenedor de Formulario
        frame_form = tk.LabelFrame(self.root, text=" Registrar Nuevo Turno ", padx=10, pady=10)
        frame_form.pack(padx=15, fill="x")
        
        tk.Label(frame_form, text="Cedula:").grid(row=0, column=0, sticky="w", pady=2)
        self.entry_cedula = tk.Entry(frame_form, width=15)
        self.entry_cedula.grid(row=0, column=1, padx=5, pady=2)
        
        tk.Label(frame_form, text="Paciente:").grid(row=0, column=2, sticky="w", pady=2)
        self.entry_paciente = tk.Entry(frame_form, width=30)
        self.entry_paciente.grid(row=0, column=3, padx=5, pady=2)
        
        tk.Label(frame_form, text="Especialidad:").grid(row=1, column=0, sticky="w", pady=2)
        self.combo_especialidad = ttk.Combobox(frame_form, values=["Medicina General", "Pediatria", "Odontologia", "Cardiologia"], width=13, state="readonly")
        self.combo_especialidad.grid(row=1, column=1, padx=5, pady=2)
        self.combo_especialidad.current(0)
        
        tk.Label(frame_form, text="Fecha (DD/MM/AAAA):").grid(row=1, column=2, sticky="w", pady=2)
        self.entry_fecha = tk.Entry(frame_form, width=12)
        self.entry_fecha.grid(row=1, column=3, sticky="w", padx=5, pady=2)
        
        tk.Label(frame_form, text="Hora (HH:MM):").grid(row=1, column=3, sticky="e", pady=2)
        self.entry_hora = tk.Entry(frame_form, width=8)
        self.entry_hora.grid(row=1, column=4, padx=5, pady=2)
        
        btn_registrar = tk.Button(frame_form, text="Registrar Turno", command=self.registrar_turno, bg="#4CAF50", fg="white")
        btn_registrar.grid(row=2, column=0, columnspan=5, pady=10, sticky="e")
        
        # Contenedor de Busqueda y Reportes
        frame_buscar = tk.Frame(self.root, pady=5)
        frame_buscar.pack(padx=15, fill="x")
        
        tk.Label(frame_buscar, text="Buscar por Cedula:").pack(side="left")
        self.entry_buscar = tk.Entry(frame_buscar, width=15)
        self.entry_buscar.pack(side="left", padx=5)
        
        btn_buscar = tk.Button(frame_buscar, text="Buscar", command=self.buscar_turno)
        btn_buscar.pack(side="left", padx=2)
        
        btn_limpiar = tk.Button(frame_buscar, text="Mostrar Todos", command=self.actualizar_tabla)
        btn_limpiar.pack(side="left", padx=2)
        
        # Tabla de Visualizacion (Reporteria)
        frame_tabla = tk.Frame(self.root)
        frame_tabla.pack(padx=15, pady=10, fill="both", expand=True)
        
        columnas = ("cedula", "paciente", "especialidad", "fecha", "hora")
        self.tabla = ttk.Treeview(frame_tabla, columns=columnas, show="headings")
        
        self.tabla.heading("cedula", text="Cedula")
        self.tabla.heading("paciente", text="Paciente")
        self.tabla.heading("especialidad", text="Especialidad")
        self.tabla.heading("fecha", text="Fecha")
        self.tabla.heading("hora", text="Hora")
        
        self.tabla.column("cedula", width=100, anchor="center")
        self.tabla.column("paciente", width=220, anchor="w")
        self.tabla.column("especialidad", width=130, anchor="center")
        self.tabla.column("fecha", width=100, anchor="center")
        self.tabla.column("hora", width=80, anchor="center")
        
        scrollbar = ttk.Scrollbar(frame_tabla, orient="vertical", command=self.tabla.yview)
        self.tabla.configure(yscrollcommand=scrollbar.set)
        
        self.tabla.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

    def registrar_turno(self):
        cedula = self.entry_cedula.get().strip()
        paciente = self.entry_paciente.get().strip()
        especialidad = self.combo_especialidad.get()
        fecha = self.entry_fecha.get().strip()
        hora = self.entry_hora.get().strip()
        
        if not (cedula and paciente and fecha and hora):
            messagebox.showwarning("Campos vacios", "Por favor, complete todos los campos.")
            return
            
        # Creacion del registro estructurado e insercion en el vector
        nuevo_turno = Turno(cedula, paciente, especialidad, fecha, hora)
        self.lista_turnos.append(nuevo_turno)
        
        messagebox.showinfo("Exito", "Turno registrado correctamente.")
        self.limpiar_formulario()
        self.actualizar_tabla()

    def actualizar_tabla(self, datos_mostrar=None):
        # Limpiar registros previos de la tabla
        for item in self.tabla.get_children():
            self.tabla.delete(item)
            
        if datos_mostrar is None:
            datos_mostrar = self.lista_turnos
            
        # Recorrido iterativo para la visualizacion (Reporteria)
        for turno in datos_mostrar:
            self.tabla.insert("", "end", values=(turno.cedula, turno.paciente, turno.especialidad, turno.fecha, turno.hora))

    def buscar_turno(self):
        termino = self.entry_buscar.get().strip()
        if not termino:
            messagebox.showwarning("Busqueda", "Ingrese una cedula para buscar.")
            return
            
        # Algoritmo de busqueda lineal sobre el vector de datos
        resultados = [t for t in self.lista_turnos if t.cedula == termino]
        
        if resultados:
            self.actualizar_tabla(resultados)
        else:
            messagebox.showinfo("Busqueda", "No se encontraron turnos con esa cedula.")

    def limpiar_formulario(self):
        self.entry_cedula.delete(0, tk.END)
        self.entry_paciente.delete(0, tk.END)
        self.entry_fecha.delete(0, tk.END)
        self.entry_hora.delete(0, tk.END)
        self.combo_especialidad.current(0)

if __name__ == "__main__":
    root = tk.Tk()
    app = AgendaTurnosApp(root)
    root.mainloop()
