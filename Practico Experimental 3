using System;
using System.Collections.Generic;

namespace SistemaBiblioteca
{
    public class Libro
    {
        public string ISBN { get; set; }
        public string Titulo { get; set; }
        public string Autor { get; set; }
        public string Categoria { get; set; }

        public Libro(string isbn, string titulo, string autor, string categoria)
        {
            ISBN = isbn;
            Titulo = titulo;
            Autor = autor;
            Categoria = categoria;
        }

        public override string ToString()
        {
            return $"[ISBN: {ISBN}] \"{Titulo}\" - {Autor} | Categoría: {Categoria}";
        }
    }

    class Program
    {
        static Dictionary<string, Libro> catalogo = new Dictionary<string, Libro>();
        static HashSet<string> categoriasUnicas = new HashSet<string>();
        static HashSet<string> librosPrestados = new HashSet<string>();

        static void Main(string[] args)
        {
            int opcion;
            do
            {
                Console.WriteLine("\n=== SISTEMA DE GESTIÓN DE BIBLIOTECA ===");
                Console.WriteLine("1. Registrar nuevo libro");
                Console.WriteLine("2. Prestar libro");
                Console.WriteLine("3. Reporte: Catálogo completo");
                Console.WriteLine("4. Reporte: Categorías registradas");
                Console.WriteLine("5. Reporte: Libros prestados");
                Console.WriteLine("6. Buscar libro por ISBN");
                Console.WriteLine("7. Salir");
                Console.Write("Seleccione una opción: ");

                string? entrada = Console.ReadLine();
                if (!int.TryParse(entrada, out opcion)) opcion = 0;

                switch (opcion)
                {
                    case 1: RegistrarLibro(); break;
                    case 2: PrestarLibro(); break;
                    case 3: MostrarCatalogo(); break;
                    case 4: MostrarCategorias(); break;
                    case 5: MostrarPrestados(); break;
                    case 6: BuscarLibro(); break;
                    case 7: Console.WriteLine("Saliendo del programa..."); break;
                    default: Console.WriteLine("Opción no válida."); break;
                }
            } while (opcion != 7);
        }

        static void RegistrarLibro()
        {
            Console.Write("\nIngrese ISBN: ");
            string isbn = Console.ReadLine()?.Trim() ?? "";

            if (string.IsNullOrEmpty(isbn))
            {
                Console.WriteLine("El ISBN no puede estar vacío.");
                return;
            }

            if (catalogo.ContainsKey(isbn))
            {
                Console.WriteLine("Error: El ISBN ya se encuentra registrado.");
                return;
            }

            Console.Write("Ingrese Título: ");
            string titulo = Console.ReadLine()?.Trim() ?? "";
            Console.Write("Ingrese Autor: ");
            string autor = Console.ReadLine()?.Trim() ?? "";
            Console.Write("Ingrese Categoría: ");
            string categoria = Console.ReadLine()?.Trim() ?? "";

            Libro nuevoLibro = new Libro(isbn, titulo, autor, categoria);
            catalogo.Add(isbn, nuevoLibro);
            if (!string.IsNullOrEmpty(categoria))
            {
                categoriasUnicas.Add(categoria);
            }

            Console.WriteLine("¡Libro registrado exitosamente!");
        }

        static void PrestarLibro()
        {
            Console.Write("\nIngrese el ISBN del libro a prestar: ");
            string isbn = Console.ReadLine()?.Trim() ?? "";

            if (!catalogo.ContainsKey(isbn))
            {
                Console.WriteLine("Error: El libro no existe en el catálogo.");
                return;
            }

            if (librosPrestados.Contains(isbn))
            {
                Console.WriteLine("El libro ya está prestado.");
            }
            else
            {
                librosPrestados.Add(isbn);
                Console.WriteLine("Préstamo registrado con éxito.");
            }
        }

        static void MostrarCatalogo()
        {
            Console.WriteLine("\n--- REPORTE: CATÁLOGO DE LIBROS ---");
            if (catalogo.Count == 0)
            {
                Console.WriteLine("No hay libros registrados.");
                return;
            }

            foreach (var item in catalogo)
            {
                string estado = librosPrestados.Contains(item.Key) ? "[PRESTADO]" : "[DISPONIBLE]";
                Console.WriteLine($"{item.Value} {estado}");
            }
        }

        static void MostrarCategorias()
        {
            Console.WriteLine("\n--- REPORTE: CATEGORÍAS REGISTRADAS (CONJUNTO) ---");
            if (categoriasUnicas.Count == 0)
            {
                Console.WriteLine("No hay categorías disponibles.");
                return;
            }

            foreach (var cat in categoriasUnicas)
            {
                Console.WriteLine($"- {cat}");
            }
        }

        static void MostrarPrestados()
        {
            Console.WriteLine("\n--- REPORTE: LIBROS EN PRÉSTAMO ---");
            if (librosPrestados.Count == 0)
            {
                Console.WriteLine("No hay libros prestados actualmente.");
                return;
            }

            foreach (var isbn in librosPrestados)
            {
                if (catalogo.TryGetValue(isbn, out Libro? libro) && libro != null)
                {
                    Console.WriteLine(libro);
                }
            }
        }

        static void BuscarLibro()
        {
            Console.Write("\nIngrese ISBN a buscar: ");
            string isbn = Console.ReadLine()?.Trim() ?? "";

            if (catalogo.TryGetValue(isbn, out Libro? libro) && libro != null)
            {
                Console.WriteLine($"Libro encontrado: {libro}");
            }
            else
            {
                Console.WriteLine("El ISBN no corresponde a ningún libro del sistema.");
            }
        }
    }
}
